# Test-phase settings for docker-compose.test.yml. Copy to .env and edit, then:
#   docker compose -f docker-compose.production.yml -f docker-compose.test.yml up -d
# (.env is gitignored — never commit the real values. This repo is public.)
# Every other option from .env.example works here too.

DOMAIN=time.desktop-tools.dzg
# Required by docker-compose.production.yml, unused (the bundled Caddy is off)
ACME_EMAIL=unused@desktop-tools.dzg

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Generate with: openssl rand -hex 24 (hex only, the app password ends up in a URL)
POSTGRES_PASSWORD=change-me
APP_DB_USER=timetracking_app
APP_DB_PASSWORD=change-me-too

# Mailpit catches every mail; read them on mail.desktop-tools.dzg
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENABLE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Zeiterfassung <no-reply@time.desktop-tools.dzg>

# Demo org "Mueller Software GmbH" with 13 users (all Password123), added once on start
SEED_DEMO_DATA=true

# Localhost ports the host Caddy proxies to (deploy/Caddyfile.test-host)
BACKEND_PORT=7100
FRONTEND_PORT=3100
MAILPIT_UI_PORT=8025

IMAGE_TAG=latest
ASPNETCORE_ENVIRONMENT=Production
