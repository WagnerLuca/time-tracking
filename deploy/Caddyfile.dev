# Reverse proxy for the dev docker-compose.yml: plain HTTP on :80 (published as
# localhost:3000), the API under the same origin as in production (deploy/Caddyfile),
# because the frontend calls window.location.origin and its CSP is connect-src 'self'.
:80 {
	# PWA (issue #67): the service worker and the manifest are always revalidated, so a deploy
	# reaches installed apps at once (the hashed /_app/immutable/* files stay cached for a year)
	@pwa path /service-worker.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"

	@api path /api/* /health
	handle @api {
		reverse_proxy backend:7000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
