{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate-api": "npx @openapitools/openapi-generator-cli generate -i http://localhost:7000/swagger/v1/swagger.json -g typescript-axios -o src/lib/api --additional-properties=supportsES6=true",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"tokens:sync": "node scripts/sync-tokens.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.0.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.2.1",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^3.2.7",
		"svelte": "^5.57.1",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.0.0",
		"vite": "^8.3.4",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"axios": "^1.20.0",
		"qrcode": "^1.5.4"
	},
	"optionalDependencies": {
		"@wagnerluca/ui": "^0.1.0"
	}
}
