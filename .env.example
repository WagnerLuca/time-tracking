# Copy to .env and edit, then:
#   docker compose -f docker-compose.production.yml up -d
# (.env is gitignored — never commit the real values. This repo is public.)

# ── Required ────────────────────────────────────────────────────────────────
# JWT signing key. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Postgres password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# ── Images ──────────────────────────────────────────────────────────────────
# "latest" follows the default branch. Pin a release (v1.2.3), a semver
# (1.2), or a commit (main-a1b2c3d) for a reproducible deploy — see the tag
# list produced by .github/workflows/{backend,frontend}.yml.
IMAGE_TAG=latest

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_VERSION=18-alpine
POSTGRES_USER=timetracking
POSTGRES_DB=timetracking
# Set true to run with the EF Core in-memory provider (no Postgres, data lost
# on restart). Useful for a throwaway demo instance.
USE_INMEMORY_DB=false

# ── Ports ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=7000
SEQ_PORT=5341

# ── App config ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
NODE_ENV=production
FRONTEND_HOST=0.0.0.0
ACCESS_TOKEN_EXPIRY_MINUTES=60
# Origin the browser loads the frontend from — must match for CORS to pass.
ALLOWED_ORIGINS=http://localhost:3000
# Leave empty to let the browser use <current-host>:7000. Set it when the API
# is behind a different hostname or a reverse proxy.
PUBLIC_API_BASE_URL=

# ── Logging (Seq) ───────────────────────────────────────────────────────────
SEQ_VERSION=latest
SEQ_ACCEPT_EULA=Y
SEQ_NO_AUTH=true
