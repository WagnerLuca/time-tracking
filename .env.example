# Copy to .env and edit, then:
#   docker compose -f docker-compose.production.yml up -d
# (.env is gitignored — never commit the real values. This repo is public.)

# ── Required ────────────────────────────────────────────────────────────────
# Public host name; its DNS record must point at this server (ports 80 + 443 open).
# Caddy fetches the Let's Encrypt certificate for it automatically.
DOMAIN=zeit.example.com
# Contact address for the Let's Encrypt account (certificate expiry notices)
ACME_EMAIL=admin@example.com
# JWT signing key. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Postgres password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Password of the app's own database role (not a superuser, so row-level security
# applies). Generate with: openssl rand -hex 24
# It ends up inside DATABASE_URL, so use only [A-Za-z0-9._~-] (hex is fine).
# The role is created automatically on a NEW data volume. For an existing database,
# run once as the superuser:
#   CREATE ROLE timetracking_app LOGIN PASSWORD '...' NOSUPERUSER NOBYPASSRLS;
#   REASSIGN OWNED BY timetracking TO timetracking_app;
#   ALTER DATABASE timetracking OWNER TO timetracking_app;
APP_DB_USER=timetracking_app
APP_DB_PASSWORD=change-me-too

# Outgoing mail (password reset, email verification). The backend refuses to start
# in Production without an SMTP host, so reset links never end up in the logs.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender; defaults to "Zeiterfassung <no-reply@$DOMAIN>". Links in mails point to https://$DOMAIN.
# EMAIL_FROM=Zeiterfassung <no-reply@zeit.example.com>

# ── Images ──────────────────────────────────────────────────────────────────
# "latest" follows the default branch. Pin a release (v1.2.3), a semver
# (1.2), or a commit (main-a1b2c3d) for a reproducible deploy — see the tag
# list produced by .github/workflows/{backend,frontend}.yml.
IMAGE_TAG=latest

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_VERSION=18-alpine
POSTGRES_USER=timetracking
POSTGRES_DB=timetracking
# Set true to run with the EF Core in-memory provider (no Postgres, data lost
# on restart). Useful for a throwaway demo instance.
USE_INMEMORY_DB=false

# ── Network ─────────────────────────────────────────────────────────────────
# Only Caddy publishes ports (80/443). Frontend :3000 and backend :7000 stay inside
# the compose network; Seq is bound to 127.0.0.1 (use an SSH tunnel).
SEQ_PORT=5341
# Fixed subnet of the compose network; the backend trusts X-Forwarded-For only from
# here. Change it only if it collides with another network on the host.
COMPOSE_SUBNET=172.30.80.0/24

# ── App config ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ACCESS_TOKEN_EXPIRY_MINUTES=15
# The frontend's API base URL and the CORS origin are both https://$DOMAIN (same origin).

# ── Proxy ───────────────────────────────────────────────────────────────────
CADDY_VERSION=2-alpine

# ── Logging (Seq) ───────────────────────────────────────────────────────────
SEQ_VERSION=latest
SEQ_ACCEPT_EULA=Y
SEQ_NO_AUTH=true
